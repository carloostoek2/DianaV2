# Secrets and local env (never commit real tokens)
.env
.env.*
!.env.example

# Virtualenvs / tooling
.venv/
venv/
.python-version

# Local OCR language data (tesseract spa/eng traineddata) — machine-specific,
# installed at runtime; the code auto-detects this dir (runtime/tessdata).
runtime/
runtime/tessdata/

.planning
.grok
.claude
# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Agent tooling local cache (skill registry, etc.)
.atl/
reasonix.toml

# Wiki knowledge graph — scratch intermedio (el knowledge-graph.json final SÍ se commitea)
wiki/.ua/intermediate/

# Understand-Anything (root) — scratch intermedio y trash de análisis
.ua/intermediate/
.ua/.trash-*/

# Understand-Anything (root) — artefactos regenerados en cada análisis
# (se re-escanean; versionar solo config.json y .understandignore)
.ua/fingerprints.json
.ua/knowledge-graph.json
.ua/meta.json

# Understand-Anything (root) — logs locales de la herramienta (no se versionan)
.ua/*.log

# Supabase CLI local (config de desarrollo local, no del producto)
supabase/
