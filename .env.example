# DianaV2 Fase 1 — copy to .env and fill in real values.
# NEVER commit .env or real secrets.

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/diana

# Optional LLM (used by later items)
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Optional ops
GLOBAL_MODE=supervised
TRACE_TTL_DAYS=30
LOG_LEVEL=INFO

# Human-like delivery wait (seconds). Supervised fixed 2 min; autonomous 3–8 min.
# DELIVERY_SUPERVISED_DELAY_MIN=120
# DELIVERY_SUPERVISED_DELAY_MAX=120
# DELIVERY_AUTONOMOUS_DELAY_MIN=180
# DELIVERY_AUTONOMOUS_DELAY_MAX=480
