# DianaV2 Fase 1 — copy to .env and fill in real values.
# NEVER commit .env or real secrets.

TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/diana

# Optional LLM (used by later items)
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Thinking (chain-of-thought) for free-text VIP drafts only. Default true.
# Analyst/Evaluator structured JSON always keeps thinking off.
# LLM_THINKING_ENABLED=true

# Optional ops
GLOBAL_MODE=supervised
TRACE_TTL_DAYS=30
LOG_LEVEL=INFO

# Feature flags — all default false (supervised/Fase 2 posture).
# Enable gradually in .env; each gate activates its surface (see README table).
# FEATURE_MEMORY_ENABLED=false
# FEATURE_GRAY_ZONE_ENABLED=false
# FEATURE_STAGING_ENABLED=false
# FEATURE_SANDBOX_ENABLED=false
# FEATURE_AUTONOMOUS_MODE=false
# FEATURE_RECONTACT_ENABLED=false
# FEATURE_PROMO_ENABLED=false
# FEATURE_CALIBRATION_ENABLED=false
# FEATURE_ADVANCED_BEHAVIOR=false
# FEATURE_PERSONA_ADMIN_ENABLED=false
# FEATURE_GENERAL_MODE_ENABLED=false

# Evo-agente (SPEC-EVOLUCION-AGENTE, F0-F5) — shadow measurement flags.
# All default false. Turning on only MEASURES/RECORDS; nothing sends, routes or
# changes generation. FEATURE_TRUST_BUDGET is inert without FEATURE_PHATIC_AUTONOMY
# (it consumes the classifier's would_autonomous). Requires migrations 024-026.
# FEATURE_EMOTIONAL_DETECTOR_ENABLED=false   # F0: emotional signal detector (writes emotional_signal_log)
# FEATURE_PROFILE_SYNTHESIS_ENABLED=false    # F1: memory resynthesis (writes vip_profile; periodic LLM job)
# FEATURE_PHATIC_AUTONOMY=false              # F2: turn classifier (writes turn_category_log)
# FEATURE_MOOD_ENGINE=false                  # F3: mood engine (writes vip_mood_state)
# FEATURE_TRUST_BUDGET=false                 # F5: trust budget per (VIP, category)

# Evo-agente thresholds (env-driven; constant, never auto-calibrated; manual override
# via system_config keys: phatic_classifier, mood_engine, trust_budget, profile_synthesis).
# PROFILE_SYNTHESIS_VOLUME_THRESHOLD=25
# PROFILE_SYNTHESIS_INACTIVITY_MINUTES=30
# PROFILE_SYNTHESIS_SCAN_INTERVAL_SECONDS=900
# PROFILE_SYNTHESIS_CONFIDENCE_MIN=0.6
# CLASSIFIER_CONFIDENCE_MIN=0.7
# PHATIC_TRUST_MIN=0.9                        # reserved Fase 5 (fast-lane threshold)
# MOOD_RETURN_RATE=0.05
# MOOD_SIGNAL_WEIGHT=0.3
# MOOD_AXIS_WEIGHTS={"playful":1.0,"warm":1.0,"energy":1.0}
# MOOD_NOISE=0.05
# TRUST_BUDGET_INITIAL=0.2
# TRUST_BUDGET_INCREMENT=0.05
# TRUST_BUDGET_DECREMENT=0.2
# TRUST_BUDGET_THRESHOLD=0.9
# TRUST_DISPERSION_HIGH=0.25
# TRUST_TREND_WINDOW_DAYS=14
# VIP_PROFILE_HISTORY_TTL_DAYS=90
# TURN_CATEGORY_LOG_TTL_DAYS=90
# EMOTIONAL_SIGNAL_LOG_TTL_DAYS=90

# VIP history seed (Telethon personal Diana account).
# Session path without .session suffix, e.g. /path/to/diana_session
# TELETHON_API_ID=
# TELETHON_API_HASH=
# TELETHON_SESSION_PATH=
# VIP_HISTORY_SEED_LIMIT=20

# Human-like delivery wait (seconds). Supervised fixed 2 min; autonomous 3–8 min.
# DELIVERY_SUPERVISED_DELAY_MIN=120
# DELIVERY_SUPERVISED_DELAY_MAX=120
# DELIVERY_AUTONOMOUS_DELAY_MIN=180
# DELIVERY_AUTONOMOUS_DELAY_MAX=480
# Micro-delays for humanized sending cadence (typing 8 chars/sec, 2–15s clamped).
# DELIVERY_TYPING_PER_CHAR=0.125
# DELIVERY_TYPING_MIN_SECONDS=2.0
# DELIVERY_TYPING_MAX_SECONDS=15.0
# DELIVERY_PRE_READ_DELAY_MIN=0.3
# DELIVERY_PRE_READ_DELAY_MAX=1.0
# DELIVERY_POST_READ_DELAY_MIN=1.5
# DELIVERY_POST_READ_DELAY_MAX=4.0
# DELIVERY_INTER_MESSAGE_GAP_MIN=1.5
# DELIVERY_INTER_MESSAGE_GAP_MAX=3.0
